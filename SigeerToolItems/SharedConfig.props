<Project>
  <!-- 项目的框架信息 -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>$(ModName)</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>$(ModName)</RootNamespace>
    <OutputType>Library</OutputType>
    <Version>0.0.1</Version>
  </PropertyGroup>

  <!-- Steam 和游戏目录的路径 -->
  <PropertyGroup>
    <SteamPath>E:/Program Files (x86)/Steam</SteamPath>
    <ElinPath>$(SteamPath)/steamapps/common/Elin</ElinPath>
    <GamePath>$(ElinPath)</GamePath>
    <ManagedPath>$(GamePath)/Elin_Data/Managed</ManagedPath>
    <BepInExPath>$(GamePath)/BepInEx</BepInExPath>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- 外部 DLL 的引用 -->
  <ItemGroup>
    <Reference Include="$(ElinPath)/Elin_Data/Managed/UnityEngine*.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(ElinPath)/BepInEx/core/BepInEx*.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(ElinPath)/BepInEx/core/0Harmony.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(ElinPath)/Elin_Data/Managed/Elin*.dll">
      <Private>False</Private>
    </Reference>
    <Reference Include="$(ElinPath)/Elin_Data/Managed/Plugins*.dll">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- 额外的引用和包引用 -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedPath)/Assembly-CSharp.dll</HintPath>
    </Reference>
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.34" IncludeAssets="compile" />
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Reflex">
      <HintPath>$(ManagedPath)\Reflex.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- 要包含在输出目录中的内容文件 -->
  <ItemGroup>
    <Content Include="package.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- 从 Base 目录引用的共享文件 -->
  <ItemGroup>
    <Compile Include="..\Base\**\*.cs">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <!-- 构建后的操作 -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <PropertyGroup>
      <ModFolder>$(GamePath)/Package/$(ModName)</ModFolder>
    </PropertyGroup>

    <MakeDir Directories="$(ModFolder)" />

    <Copy 
      SourceFiles="$(TargetPath)"
      DestinationFolder="$(ModFolder)"
      SkipUnchangedFiles="true"
    />

    <Copy 
      SourceFiles="package.xml"
      DestinationFolder="$(ModFolder)"
      SkipUnchangedFiles="true"
    />

    <Message Text="Copied $(TargetFileName) to $(ModFolder)" Importance="high" />
  </Target>
</Project>